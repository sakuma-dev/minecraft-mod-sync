<Window x:Class="ModSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minecraft MOD Sync" Height="400" Width="660"
        MinHeight="360" MinWidth="600" WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Meiryo UI" FontSize="14"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Minecraft MOD Sync" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Text="開発用プレビュー" Margin="0,4,0,0" Foreground="{DynamicResource MutedForegroundBrush}" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,24,0,24" Padding="24"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="最小アプリが起動しました" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource MutedForegroundBrush}"
                           Text="専用インスタンスの作成・構成の更新・サーバー参加は、これから追加します。この版は起動確認用です。" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="参加（準備中）" IsEnabled="False" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
            <Button Content="閉じる" Style="{StaticResource OutlineButtonStyle}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
